# ── Server Configuration ──────────────────────────────────────────
# Host must be 0.0.0.0 inside Docker so the container can accept external requests
HOST=0.0.0.0
PORT=8787

# Required to allow the app to bind to 0.0.0.0 instead of strictly loopback
MODEL_COUNCIL_ALLOW_NETWORK=1

# ── Security / Browser Origins ───────────────────────────────────
# Comma-separated list of allowed browser origins (e.g., http://localhost:8787,http://127.0.0.1:8787)
# Set to "*" to allow all origins (less secure, but fine for local development)
MODEL_COUNCIL_ALLOWED_ORIGINS=*

# ── Ollama Configuration ─────────────────────────────────────────
# Set to 1 to allow the app to talk to an Ollama instance running on another machine or outside Docker
MODEL_COUNCIL_ALLOW_REMOTE_OLLAMA=0

# ── Redis Memory Configuration ────────────────────────────────────
# Uses the 'redis' service name defined in docker-compose.yml
MODEL_COUNCIL_REDIS_URL=redis://localhost:6379/0

# How long to remember conversation history (in seconds). 86400 = 24 hours
MODEL_COUNCIL_MEMORY_TTL=86400

# Maximum number of conversation rounds to keep in memory per session
MODEL_COUNCIL_MEMORY_MAX_ROUNDS=8

# ── Logging ───────────────────────────────────────────────────────
# Set to DEBUG for verbose output, or INFO for standard output
LOG_LEVEL=INFO